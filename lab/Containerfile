FROM docker.io/kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive

# Install QEMU, kernel, cryptsetup, dropbear, and minimal build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    qemu-system-x86 \
    qemu-utils \
    cryptsetup-bin \
    cryptsetup \
    dropbear-bin \
    busybox-static \
    linux-image-amd64 \
    initramfs-tools \
    e2fsprogs \
    openssh-client \
    iproute2 \
    procps \
    socat \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /lab

COPY . /lab/
RUN chmod +x /lab/*.sh 2>/dev/null || true

EXPOSE 2222

ENTRYPOINT ["/lab/entrypoint.sh"]
